# Copy this file to .env and adjust if needed.
# These defaults match docker-compose.yml when running everything with `docker-compose up`.

# For running api/worker locally (outside Docker), use localhost:
DATABASE_URL=postgresql://task_admin:SecurePassword123@localhost:5432/taskflow_history
REDIS_URL=redis://localhost:6379/0

# Optional: paste a Slack (or Discord/other webhook-compatible) incoming webhook URL here
# to get real-time alerts when a task exhausts retries and lands in the Dead Letter Queue.
# Leave blank to just log alerts to the console instead.
ALERT_WEBHOOK_URL=

# Optional: real SMTP email alerting when a task lands in the Dead Letter Queue.
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=<a 16-character Gmail "App Password" - NOT your normal password>
#   ALERT_EMAIL_TO=whereveryouwanttheemail@example.com
# To generate an App Password: Google Account -> Security -> 2-Step Verification must be ON,
# then Security -> App Passwords -> create one for "Mail". Regular Gmail passwords won't work
# here since Google blocks direct SMTP login with your normal password for security reasons.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# For running api/worker as part of docker-compose, use the service names instead:
# DATABASE_URL=postgresql://task_admin:SecurePassword123@postgres:5432/taskflow_history
# REDIS_URL=redis://redis:6379/0
